(pcb pair_pad_ring
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 40000 30000))
    (via "Via[0-1]_600:300_um")
    (rule (width 150) (clearance 150)))
  (placement
    (component Quad
      (place U1 20000 15000 front 0))
    (component Conn
      (place J1 8000 15000 front 0)))
  (library
    (image Quad
      (pin PadV 1 -3000 -2000)
      (pin PadV 2 -3000 -1000)
      (pin PadV 3 -3000 0)
      (pin PadV 4 -3000 1000)
      (pin PadV 5 -3000 2000)
      (pin PadH 6 -2000 -3000)
      (pin PadH 7 -1000 -3000)
      (pin PadH 8 0 -3000)
      (pin PadH 9 1000 -3000)
      (pin PadH 10 2000 -3000)
      (pin PadV 11 3000 -2000)
      (pin PadV 12 3000 -1000)
      (pin PadV 13 3000 0)
      (pin PadV 14 3000 1000)
      (pin PadV 15 3000 2000)
      (pin PadH 16 -2000 3000)
      (pin PadH 17 -1000 3000)
      (pin PadH 18 0 3000)
      (pin PadH 19 1000 3000)
      (pin PadH 20 2000 3000))
    (image Conn
      (pin PadH 1 0 0)
      (pin PadH 2 0 -800))
    (padstack PadV (shape (rect F.Cu -500 -200 500 200)) (attach off))
    (padstack PadH (shape (rect F.Cu -200 -500 200 500)) (attach off))
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off)))
  (network
    (net D+ (pins U1-14 J1-1))
    (net D- (pins U1-13 J1-2))
    (net Q1 (pins U1-1))
    (net Q2 (pins U1-2))
    (net Q3 (pins U1-3))
    (net Q4 (pins U1-4))
    (net Q5 (pins U1-5))
    (net Q6 (pins U1-6))
    (net Q7 (pins U1-7))
    (net Q8 (pins U1-8))
    (net Q9 (pins U1-9))
    (net Q10 (pins U1-10))
    (net Q11 (pins U1-11))
    (net Q12 (pins U1-12))
    (net Q15 (pins U1-15))
    (net Q16 (pins U1-16))
    (net Q17 (pins U1-17))
    (net Q18 (pins U1-18))
    (net Q19 (pins U1-19))
    (net Q20 (pins U1-20))
    (class kicad_default "" D+ D- Q1 Q2 Q3 Q4 Q5 Q6 Q7 Q8 Q9 Q10 Q11 Q12 Q15 Q16 Q17 Q18 Q19 Q20
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 150) (clearance 150)))
    (pair (nets D+ D- (gap 200)))))
