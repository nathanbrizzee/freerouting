(pcb unreachable_plane_via
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer In1.Cu (type power))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 50000 30000))
    (plane GND (polygon In1.Cu 0 0 0 50000 0 50000 30000 0 30000))
    (via "Via[0-2]_600:300_um")
    (rule (width 150) (clearance 150)))
  (placement
    (component Part
      (place J1 10000 15000 front 0)
      (place U1 40000 15000 back 0)
      (place G1 25000 5000 front 0)))
  (library
    (image Part
      (pin Pad 1 0 0))
    (padstack Pad (shape (rect F.Cu -300 -300 300 300)) (attach off))
    (padstack "Via[0-2]_600:300_um"
      (shape (circle F.Cu 600)) (shape (circle In1.Cu 600)) (shape (circle B.Cu 600))
      (attach off)))
  (network
    (net A (pins J1-1 U1-1))
    (net GND (pins G1-1))
    (class kicad_default "" A GND
      (circuit (use_via "Via[0-2]_600:300_um"))
      (rule (width 150) (clearance 150)))))
