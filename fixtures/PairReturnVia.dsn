(pcb pair_return_via
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer In1.Cu (type power))
    (layer In2.Cu (type power))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 50000 30000))
    (plane GND (polygon In1.Cu 0 0 0 50000 0 50000 30000 0 30000 0 0))
    (via "Via[0-3]_600:300_um")
    (rule (width 150) (clearance 150)))
  (placement
    (component Conn
      (place J1 5000 10000 front 0))
    (component Conn
      (place U1 45000 12000 back 0)))
  (library
    (image Conn
      (pin Pad 1 0 0)
      (pin Pad 2 0 800))
    (padstack Pad (shape (rect F.Cu -500 -200 500 200)) (attach off))
    (padstack "Via[0-3]_600:300_um"
      (shape (circle F.Cu 600)) (shape (circle In1.Cu 600)) (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600)) (attach off)))
  (network
    (net D+ (pins J1-1 U1-1))
    (net D- (pins J1-2 U1-2))
    (net GND)
    (class kicad_default "" D+ D- GND
      (circuit (use_via "Via[0-3]_600:300_um"))
      (rule (width 150) (clearance 150)))
    (pair (nets D+ D- (gap 200)))))
