(pcb overlap_contacts
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 50000 20000))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 200)))
  (placement
    (component R_0603
      (place R1 5000 10000 front 0)
      (place R2 6400 10000 front 0)
      (place R3 20000 10000 front 0)
      (place R4 30000 10000 front 0)
      (place R5 38000 15000 front 0)
      (place R6 46000 15000 front 0)))
  (library
    (image R_0603
      (pin Pad_800x950_um 1 -800 0)
      (pin Pad_800x950_um 2 800 0))
    (padstack Pad_800x950_um (shape (rect F.Cu -400 -475 400 475)) (attach off))
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off)))
  (network
    (net A (pins R1-2 R2-1))
    (net B (pins R3-2 R4-1))
    (net C (pins R5-2 R6-1))
    (class kicad_default "" A B C
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 200) (clearance 200))))
  (wiring
    (via "Via[0-1]_600:300_um" 21000 10000 (net B) (type fix))
    (wire (path B.Cu 200 21000 10000 29200 10000) (net B) (type fix))
    (via "Via[0-1]_600:300_um" 29200 10000 (net B) (type fix))
    (wire (path F.Cu 200 39000 15000 45200 15000) (net C) (type fix))))
