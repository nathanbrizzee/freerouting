(pcb neck_wide_stub
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (boundary (rect pcb 0 0 20000 10000))
    (keepout (rect F.Cu 5700 0 6300 4700))
    (keepout (rect F.Cu 5700 5300 6300 10000))
    (rule (width 200) (clearance 200)))
  (placement
    (component PAD1
      (place G1 5000 5000 front 0)
      (place G2 7000 5000 front 0)
      (place S1 2000 2000 front 0)
      (place S2 4000 2000 front 0)
      (place T1 14000 2000 front 0)
      (place T2 16000 2000 front 0)))
  (library
    (image PAD1
      (pin Pad_600_um 1 0 0))
    (padstack Pad_600_um (shape (rect F.Cu -300 -300 300 300)) (attach off)))
  (network
    (net G (pins G1-1 G2-1))
    (net S (pins S1-1 S2-1))
    (net T (pins T1-1 T2-1))
    (class kicad_default S T
      (rule (width 200) (clearance 200)))
    (class POWER G
      (rule (width 300) (clearance 200))))
  (wiring))
