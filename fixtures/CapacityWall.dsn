(pcb capacity_wall
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 60000 30000))
    (via "Via[0-1]_600:300_um")
    (keepout (rect F.Cu 29000 0 31000 14000))
    (keepout (rect F.Cu 29000 16000 31000 30000))
    (keepout (rect B.Cu 29000 0 31000 14000))
    (keepout (rect B.Cu 29000 16000 31000 30000))
    (rule (width 150) (clearance 150)))
  (placement
    (component Left
      (place J0 5000 3000 front 0)
      (place J1 5000 4000 front 0)
      (place J2 5000 5000 front 0)
      (place J3 5000 6000 front 0)
      (place J4 5000 7000 front 0)
      (place J5 5000 8000 front 0)
      (place J6 5000 9000 front 0)
      (place J7 5000 10000 front 0)
      (place J8 5000 11000 front 0)
      (place J9 5000 12000 front 0)
      (place J10 5000 13000 front 0)
      (place J11 5000 14000 front 0)
      (place J12 5000 15000 front 0)
      (place J13 5000 16000 front 0)
      (place J14 5000 17000 front 0)
      (place J15 5000 18000 front 0)
      (place J16 5000 19000 front 0)
      (place J17 5000 20000 front 0)
      (place J18 5000 21000 front 0)
      (place J19 5000 22000 front 0)
      (place J20 5000 23000 front 0)
      (place J21 5000 24000 front 0)
      (place J22 5000 25000 front 0)
      (place J23 5000 26000 front 0)
    )
    (component Right
      (place U0 55000 3000 front 0)
      (place U1 55000 4000 front 0)
      (place U2 55000 5000 front 0)
      (place U3 55000 6000 front 0)
      (place U4 55000 7000 front 0)
      (place U5 55000 8000 front 0)
      (place U6 55000 9000 front 0)
      (place U7 55000 10000 front 0)
      (place U8 55000 11000 front 0)
      (place U9 55000 12000 front 0)
      (place U10 55000 13000 front 0)
      (place U11 55000 14000 front 0)
      (place U12 55000 15000 front 0)
      (place U13 55000 16000 front 0)
      (place U14 55000 17000 front 0)
      (place U15 55000 18000 front 0)
      (place U16 55000 19000 front 0)
      (place U17 55000 20000 front 0)
      (place U18 55000 21000 front 0)
      (place U19 55000 22000 front 0)
      (place U20 55000 23000 front 0)
      (place U21 55000 24000 front 0)
      (place U22 55000 25000 front 0)
      (place U23 55000 26000 front 0)
    ))
  (library
    (image Left
      (pin Pad 1 0 0))
    (image Right
      (pin Pad 1 0 0))
    (padstack Pad (shape (rect F.Cu -300 -300 300 300)) (attach off))
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off)))
  (network
    (net N0 (pins J0-1 U0-1))
    (net N1 (pins J1-1 U1-1))
    (net N2 (pins J2-1 U2-1))
    (net N3 (pins J3-1 U3-1))
    (net N4 (pins J4-1 U4-1))
    (net N5 (pins J5-1 U5-1))
    (net N6 (pins J6-1 U6-1))
    (net N7 (pins J7-1 U7-1))
    (net N8 (pins J8-1 U8-1))
    (net N9 (pins J9-1 U9-1))
    (net N10 (pins J10-1 U10-1))
    (net N11 (pins J11-1 U11-1))
    (net N12 (pins J12-1 U12-1))
    (net N13 (pins J13-1 U13-1))
    (net N14 (pins J14-1 U14-1))
    (net N15 (pins J15-1 U15-1))
    (net N16 (pins J16-1 U16-1))
    (net N17 (pins J17-1 U17-1))
    (net N18 (pins J18-1 U18-1))
    (net N19 (pins J19-1 U19-1))
    (net N20 (pins J20-1 U20-1))
    (net N21 (pins J21-1 U21-1))
    (net N22 (pins J22-1 U22-1))
    (net N23 (pins J23-1 U23-1))
    (class kicad_default "" N0 N1 N2 N3 N4 N5 N6 N7 N8 N9 N10 N11 N12 N13 N14 N15 N16 N17 N18 N19 N20 N21 N22 N23
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 150) (clearance 150)))))
