(pcb unreachable_narrow_gap
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 50000 30000))
    (via "Via[0-1]_600:300_um")
    (keepout (rect F.Cu 38000 16600 42000 17000))
    (keepout (rect F.Cu 38000 13000 42000 13400))
    (keepout (rect F.Cu 41600 13400 42000 16600))
    (keepout (rect F.Cu 38000 13400 38400 14750))
    (keepout (rect F.Cu 38000 15250 38400 16600))
    (keepout (rect B.Cu 38000 16600 42000 17000))
    (keepout (rect B.Cu 38000 13000 42000 13400))
    (keepout (rect B.Cu 41600 13400 42000 16600))
    (keepout (rect B.Cu 38000 13400 38400 14750))
    (keepout (rect B.Cu 38000 15250 38400 16600))
    (rule (width 150) (clearance 150)))
  (placement
    (component Left
      (place J1 10000 15000 front 0)
      (place J2 10000 5000 front 0))
    (component Right
      (place U1 40000 15000 front 0)
      (place U2 40000 5000 front 0)))
  (library
    (image Left
      (pin Pad 1 0 0))
    (image Right
      (pin Pad 1 0 0))
    (padstack Pad (shape (rect F.Cu -300 -300 300 300)) (attach off))
    (padstack "Via[0-1]_600:300_um"
      (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off)))
  (network
    (net A (pins J1-1 U1-1))
    (net B (pins J2-1 U2-1))
    (class kicad_default "" A B
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 150) (clearance 150)))))
